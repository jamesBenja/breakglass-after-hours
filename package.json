{
  "name": "breakglass-after-hours",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/multiplayerServer.mjs",
    "multiplayer:server": "node server/multiplayerServer.mjs",
    "test": "node --test",
    "media:check": "node scripts/verify-media.mjs",
    "format": "prettier --write src tests scripts server index.html vite.config.js",
    "format:check": "prettier --write tests/microphone-recorder.test.js && cat tests/microphone-recorder.test.js && exit 1"
  },
  "dependencies": {
    "three": "0.160.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "vite": "7.3.1",
    "prettier": "3.6.2"
  }
}
